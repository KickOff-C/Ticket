  id_deuda     Int       @default(0)
  Parcela      String?   @db.VarChar(255)
  fecha_pagare DateTime? @db.Date
  id_pagare    Int?
  GGCC_UF      String?   @map("GGCC UF") @db.VarChar(255)
  deuda_uf     Decimal?  @db.Decimal(14, 8)
  creditoUF    Float?    @db.Float

  @@ignore
}

