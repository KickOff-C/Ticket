generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model usuarios {
  Id_Ejecutivo                                                 Int                        @id @default(autoincrement()) @map("Id_Ejecutivo")
  Nombre                                                       String?                    @map("Nombre") @db.VarChar(255)
  RUT                                                          String?                    @map("RUT") @db.VarChar(255)
  Login                                                        String?                    @unique(map: "Login") @map("Login") @db.VarChar(8)
  password                                                     String?                    @map("password") @db.VarChar(255)
  login_sw                                                     String?                    @map("login_sw") @db.VarChar(10)
  Correo                                                       String?                    @map("Correo") @db.VarChar(100)
  Anexo                                                        String?                    @map("Anexo") @db.VarChar(50)
  Supervisor                                                   Int?                       @map("Supervisor")
  activo                                                       Int?                       @map("activo")
  puede_agendar                                                Int?                       @map("puede_agendar")
  id_cargo                                                     Int?                       @map("id_cargo")
  atiende_visitas                                              Int?                       @map("atiende_visitas")
  tiene_personal_a_cargo                                       Int?                       @map("tiene_personal_a_cargo")
  fecha_ingreso                                                DateTime?                  @map("fecha_ingreso") @db.Date
  ultima_sesion                                                DateTime?                  @map("ultima_sesion") @db.DateTime(0)
  fecha_nacimiento                                             DateTime?                  @map("fecha_nacimiento") @db.Date
  sexo                                                         Int?                       @map("sexo")
  telefono                                                     Int?                       @map("telefono")
  fecha_desactivado                                            DateTime?                  @map("fecha_desactivado") @db.Date
  software                                                     String?                    @map("software") @db.VarChar(20)
  pantalla_bienvenida                                          String?                    @map("pantalla_bienvenida") @db.VarChar(255)
  id_area                                                      Int?                       @map("id_area")
  password_tk                                                  String                     @map("password_tk") @db.Char(64)
  comments                                                     TK_comments[]
  ticketHistory                                                TK_ticket_history[]
  createdTickets                                               TK_tickets[]               @relation("TicketCreator")
  assignedTickets                                              TK_tickets[]               @relation("TicketAssigned")
  createdTicketsTI                                             TK_tickets_ti[]            @relation("TicketTICreator")
  assignedTicketsTI                                            TK_tickets_ti[]            @relation("TicketTIAssigned")
  requestedTransfers                                           TK_transfer_requests[]     @relation("TransferRequestedBy")
  approvedTransfers                                            TK_transfer_requests[]     @relation("TransferApprovedBy")
  ticketData                                                   TK_user_ticket_data?
  managedArea                                                  area?                      @relation("AreaManager")
  cob_asignacion_proyectos                                     cob_asignacion_proyectos[] @ignore
  gestiones                                                    gestiones[]
  la_documentos_agua                                           la_documentos_agua[]
  ra_asistencia                                                ra_asistencia[]
  sco_carta_oferta_sco_carta_oferta_vendedorTousuarios         sco_carta_oferta[]         @relation("sco_carta_oferta_vendedorTousuarios")
  sco_carta_oferta_sco_carta_oferta_jefe_proy_iTousuarios      sco_carta_oferta[]         @relation("sco_carta_oferta_jefe_proy_iTousuarios")
  sco_carta_oferta_sco_carta_oferta_agente_callTousuarios      sco_carta_oferta[]         @relation("sco_carta_oferta_agente_callTousuarios")
  sco_carta_oferta_sco_carta_oferta_guiaTousuarios             sco_carta_oferta[]         @relation("sco_carta_oferta_guiaTousuarios")
  sco_carta_oferta_sco_carta_oferta_cerradorTousuarios         sco_carta_oferta[]         @relation("sco_carta_oferta_cerradorTousuarios")
  sco_carta_oferta_sco_carta_oferta_gerente_vTousuarios        sco_carta_oferta[]         @relation("sco_carta_oferta_gerente_vTousuarios")
  sco_carta_oferta_sco_carta_oferta_confirmador_callTousuarios sco_carta_oferta[]         @relation("sco_carta_oferta_confirmador_callTousuarios")
  sco_carta_oferta_sco_carta_oferta_super_callTousuarios       sco_carta_oferta[]         @relation("sco_carta_oferta_super_callTousuarios")
  sco_pagos_co                                                 sco_pagos_co[]
  sys_acceso_softwares                                         sys_acceso_softwares[]
  sys_permisos_sw                                              sys_permisos_sw[]
  area                                                         area?                      @relation(fields: [id_area], references: [id_area], map: "fk_usuario_area")
  cargos                                                       cargos?                    @relation(fields: [id_cargo], references: [id_cargo], map: "usuarios_ibfk_1")
  supervisorRel                                                usuarios?                  @relation("SupervisorRelation", fields: [Supervisor], references: [Id_Ejecutivo], map: "usuarios_ibfk_2")
  subordinates                                                 usuarios[]                 @relation("SupervisorRelation")

  @@index([Supervisor], map: "Supervisor")
  @@index([id_cargo], map: "ejecutivos_ibfk_1")
  @@index([id_area], map: "fk_usuario_area")
  @@index([Nombre(length: 191)], map: "idx_nombre")
  @@index([sexo], map: "sexo")
  @@map("usuarios")
}

model TK_user_ticket_data {
  userId        Int       @id @map("userId")
  role          String?   @default("USER") @db.VarChar(20)
  ticketsClosed Int?      @default(0)
  createdAt     DateTime? @default(now()) @db.DateTime(0)
  updatedAt     DateTime? @default(now()) @updatedAt @db.DateTime(0)
  user          usuarios  @relation(fields: [userId], references: [Id_Ejecutivo], onDelete: Cascade, onUpdate: NoAction, map: "tk_user_ticket_data_ibfk_1")

  @@index([createdAt], map: "TK_idx_created_at")
  @@index([role], map: "TK_idx_role")
  @@map("TK_user_ticket_data")
}

model area {
  id_area       Int                    @id @default(autoincrement()) @map("id_area")
  nombre_area   String                 @map("nombre_area") @db.VarChar(100)
  TK_managerId  Int?                   @unique(map: "TK_unique_manager") @map("TK_managerId")
  TK_createdAt  DateTime?              @default(now()) @map("TK_createdAt") @db.DateTime(0)
  tickets       TK_tickets[]
  transfersFrom TK_transfer_requests[] @relation("TransferFrom")
  transfersTo   TK_transfer_requests[] @relation("TransferTo")
  manager       usuarios?              @relation("AreaManager", fields: [TK_managerId], references: [Id_Ejecutivo], map: "TK_fk_area_manager")
  users         usuarios[]

  @@map("area")
}

model TK_tickets {
  id             Int                    @id @default(autoincrement())
  title          String                 @db.VarChar(255)
  description    String                 @db.Text
  status         String?                @default("ABIERTO") @db.VarChar(50)
  priority       String?                @default("MEDIA") @db.VarChar(50)
  createdAt      DateTime?              @default(now()) @db.DateTime(0)
  updatedAt      DateTime?              @default(now()) @updatedAt @db.DateTime(0)
  lastActivityAt DateTime?              @default(now()) @db.DateTime(0)
  closedAt       DateTime?              @db.DateTime(0)
  creatorId      Int
  assignedToId   Int?
  areaId         Int
  entrada        TK_tickets_entrada?
  motivo         TK_tickets_motivo?
  parcelaId      Int?
  propietarioId  Int?
  comments       TK_comments[]
  history        TK_ticket_history[]
  parcela        sys_parcelas?          @relation(fields: [parcelaId], references: [id_parcela], map: "fk_ticket_parcela")
  propietario    deudores?              @relation(fields: [propietarioId], references: [id], map: "fk_ticket_propietario")
  creator        usuarios               @relation("TicketCreator", fields: [creatorId], references: [Id_Ejecutivo], onUpdate: NoAction, map: "tk_tickets_ibfk_1")
  assignedTo     usuarios?              @relation("TicketAssigned", fields: [assignedToId], references: [Id_Ejecutivo], onUpdate: NoAction, map: "tk_tickets_ibfk_2")
  area           area                   @relation(fields: [areaId], references: [id_area], onUpdate: NoAction, map: "tk_tickets_ibfk_3")
  transfers      TK_transfer_requests[]

  @@index([areaId], map: "TK_idx_area")
  @@index([assignedToId], map: "TK_idx_assigned")
  @@index([createdAt], map: "TK_idx_created_at")
  @@index([creatorId], map: "TK_idx_creator")
  @@index([entrada], map: "TK_idx_entrada")
  @@index([lastActivityAt], map: "TK_idx_last_activity")
  @@index([motivo], map: "TK_idx_motivo")
  @@index([parcelaId], map: "TK_idx_parcela")
  @@index([priority], map: "TK_idx_priority")
  @@index([propietarioId], map: "TK_idx_propietario")
  @@index([status], map: "TK_idx_status")
  @@map("TK_tickets")
}

model TK_tickets_ti {
  id             Int           @id @default(autoincrement())
  title          String        @db.VarChar(255)
  description    String        @db.Text
  status         String?       @default("ABIERTO") @db.VarChar(50)
  priority       String?       @default("MEDIA") @db.VarChar(50)
  createdAt      DateTime?     @default(now()) @db.DateTime(0)
  updatedAt      DateTime?     @default(now()) @updatedAt @db.DateTime(0)
  lastActivityAt DateTime?     @default(now()) @db.DateTime(0)
  closedAt       DateTime?     @db.DateTime(0)
  creatorId      Int
  assignedToId   Int?
  area           String?       @default("TI") @db.VarChar(50)
  comments       TK_comments[]
  creator        usuarios      @relation("TicketTICreator", fields: [creatorId], references: [Id_Ejecutivo], onUpdate: NoAction, map: "tk_tickets_ti_ibfk_1")
  assignedTo     usuarios?     @relation("TicketTIAssigned", fields: [assignedToId], references: [Id_Ejecutivo], onUpdate: NoAction, map: "tk_tickets_ti_ibfk_2")

  @@index([assignedToId], map: "TK_idx_assigned_ti")
  @@index([createdAt], map: "TK_idx_created_at_ti")
  @@index([creatorId], map: "TK_idx_creator_ti")
  @@index([lastActivityAt], map: "TK_idx_last_activity_ti")
  @@index([priority], map: "TK_idx_priority_ti")
  @@index([status], map: "TK_idx_status_ti")
  @@map("TK_tickets_ti")
}

model TK_comments {
  id         Int            @id @default(autoincrement())
  content    String         @db.Text
  createdAt  DateTime?      @default(now()) @db.DateTime(0)
  userId     Int
  ticketId   Int?
  ticketTIId Int?
  user       usuarios       @relation(fields: [userId], references: [Id_Ejecutivo], onDelete: Cascade, onUpdate: NoAction, map: "tk_comments_ibfk_1")
  ticket     TK_tickets?    @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tk_comments_ibfk_2")
  ticketTI   TK_tickets_ti? @relation(fields: [ticketTIId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tk_comments_ibfk_3")

  @@index([createdAt], map: "TK_idx_created_at_comment")
  @@index([ticketId], map: "TK_idx_ticket_comment")
  @@index([ticketTIId], map: "TK_idx_ticket_ti_comment")
  @@index([userId], map: "TK_idx_user_comment")
  @@map("TK_comments")
}

model TK_transfer_requests {
  id            Int        @id @default(autoincrement())
  ticketId      Int
  fromAreaId    Int
  toAreaId      Int
  requestedById Int
  status        String?    @default("PENDIENTE") @db.VarChar(50)
  approvedById  Int?
  createdAt     DateTime?  @default(now()) @db.DateTime(0)
  updatedAt     DateTime?  @default(now()) @updatedAt @db.DateTime(0)
  ticket        TK_tickets @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tk_transfer_requests_ibfk_1")
  fromArea      area       @relation("TransferFrom", fields: [fromAreaId], references: [id_area], onUpdate: NoAction, map: "tk_transfer_requests_ibfk_2")
  toArea        area       @relation("TransferTo", fields: [toAreaId], references: [id_area], onUpdate: NoAction, map: "tk_transfer_requests_ibfk_3")
  requestedBy   usuarios   @relation("TransferRequestedBy", fields: [requestedById], references: [Id_Ejecutivo], onUpdate: NoAction, map: "tk_transfer_requests_ibfk_4")
  approvedBy    usuarios?  @relation("TransferApprovedBy", fields: [approvedById], references: [Id_Ejecutivo], onUpdate: NoAction, map: "tk_transfer_requests_ibfk_5")

  @@index([approvedById], map: "TK_idx_approved_by")
  @@index([createdAt], map: "TK_idx_created_at_transfer")
  @@index([fromAreaId], map: "TK_idx_from_area")
  @@index([requestedById], map: "TK_idx_requested_by")
  @@index([status], map: "TK_idx_status_transfer")
  @@index([ticketId], map: "TK_idx_ticket_transfer")
  @@index([toAreaId], map: "TK_idx_to_area")
  @@map("TK_transfer_requests")
}

model TK_ticket_history {
  id        Int        @id @default(autoincrement())
  ticketId  Int
  action    String     @db.VarChar(100)
  oldValue  String?    @db.Text
  newValue  String?    @db.Text
  details   String?    @db.Text
  userId    Int
  createdAt DateTime?  @default(now()) @db.DateTime(0)
  ticket    TK_tickets @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tk_ticket_history_ibfk_1")
  user      usuarios   @relation(fields: [userId], references: [Id_Ejecutivo], onUpdate: NoAction, map: "tk_ticket_history_ibfk_2")

  @@index([action], map: "TK_idx_action_history")
  @@index([createdAt], map: "TK_idx_created_at_history")
  @@index([ticketId], map: "TK_idx_ticket_history")
  @@index([userId], map: "TK_idx_user_history")
  @@map("TK_ticket_history")
}

model sys_parcelas {
  id_parcela               Int                       @id @default(autoincrement()) @map("id_parcela")
  codigo_parcela           String?                   @unique(map: "codigo_parcela") @map("codigo_parcela") @db.VarChar(255)
  nombre_legal             String?                   @map("nombre_legal") @db.VarChar(255)
  dominio                  String?                   @map("dominio") @db.VarChar(255)
  proyecto                 String?                   @map("proyecto") @db.VarChar(255)
  sector                   String?                   @map("sector") @db.VarChar(255)
  rol                      String?                   @map("rol") @db.VarChar(255)
  superficie_total         String?                   @map("superficie_total") @db.VarChar(255)
  superficie_servidumbre   String?                   @map("superficie_servidumbre") @db.VarChar(255)
  superficie_util          String?                   @map("superficie_util") @db.VarChar(255)
  existe                   Int?                      @map("existe")
  id_proyecto              Int?                      @map("id_proyecto")
  revisada                 Int?                      @map("revisada") @db.TinyInt
  precio_lista             Int?                      @map("precio_lista")
  stock                    Int?                      @map("stock")
  estado_general           Int?                      @map("estado_general")
  seleccionable            Int?                      @default(1) @map("seleccionable")
  tipo_parcela             Int?                      @map("tipo_parcela")
  id_empresa_agua          Int?                      @map("id_empresa_agua")
  co_num_parcela           String?                   @map("co_num_parcela") @db.VarChar(100)
  tickets                  TK_tickets[]
  la_documentos_agua       la_documentos_agua[]
  pa_parcelas_servicios    pa_parcelas_servicios[]
  sco_carta_oferta         sco_carta_oferta[]
  sys_construcciones       sys_construcciones?
  sys_estados_gral_parcela sys_estados_gral_parcela? @relation(fields: [estado_general], references: [id_estado_general], onDelete: Cascade, map: "sys_parcelas_ibfk_1")

  @@index([estado_general], map: "estado_general")
  @@map("sys_parcelas")
}

model deudores {
  id            Int          @id @default(autoincrement())
  parcela       String?      @map("parcela") @db.VarChar(50)
  rut           String?      @map("rut") @db.VarChar(20)
  nombre        String?      @map("nombre") @db.VarChar(100)
  tipo_deudor   String?      @map("tipo_deudor") @db.VarChar(20)
  activo        Int?         @map("activo")
  fono          Int?         @map("fono")
  mail          String?      @map("mail") @db.VarChar(100)
  fecha_ingreso DateTime?    @map("fecha_ingreso") @db.DateTime(0)
  ingresado_por Int?         @map("ingresado_por")
  id_pagare     Int?         @map("id_pagare")
  direccion     String?      @map("direccion") @db.VarChar(255)
  comuna        Int?         @map("comuna")
  tickets       TK_tickets[]
  sys_comunas   sys_comunas? @relation(fields: [comuna], references: [Id_Comuna], map: "deudores_ibfk_1")
  gestiones     gestiones[]

  @@unique([parcela, nombre], map: "parcela")
  @@index([activo], map: "activo")
  @@index([comuna], map: "comuna")
  @@index([parcela], map: "parcela_2")
  @@index([tipo_deudor], map: "tipo_deudor")
  @@map("deudores")
}

